# ── Python virtual environments (rebuilt from requirements.txt) ──
**/.venv/
**/venv/
**/__pycache__/
*.pyc

# ── Build output ──
# NOTE: git has no inline comments — a trailing "# …" becomes part of the
# pattern and silently matches nothing. Keep comments on their own line.
# MkDocs
**/site/
# Honkit/GitBook
**/_book/

# ── Pipeline local artefacts (regenerable; 4K originals are large) ──
**/.cache/
**/logs/

# ── Secrets & local tooling config ──
**/.env
**/.env.example
.claude/

# ── Node (gitbook track) ──
**/node_modules/

# ── OS / editor cruft ──
.DS_Store
Thumbs.db
*.log

# ── Local backups (e.g. mkdocs.yml.pre-v5.bak) — never publish ──
*.bak
*.orig
*~

# ── website_checker.sh output (regenerable audit report) ──
website_link_report.md

# ── Publish ONLY the v3 site to GitHub. Everything below stays local. ──
/gitbook/
/github-pages/
# superseded v3 pipeline (contains local LLM-client code refs) — never publish
/old_v3-github-pages/
/github-pages-v3/pipeline/
/github-pages-v3/README.md
/v3-github-pages/
# local curriculum generator + specs (its output already lives in github-pages-v3/docs/workshops)
/workshop_design/
/start_gitpages_server.sh
/start_gitpages_v2_server.sh
/01_setup_gh.sh
/Improv_Framework.json
/Assets/
# local reference material (57 MB of source PNGs and working notes)
/Ref/
# local helper scripts — the deploy is GitHub Actions (.github/workflows/deploy.yml),
# so none of these run in CI and none of them need to be published
/00_push_to_github_pages.sh
/start_local_server.sh
/website_checker.py
/website_checker.sh

# ── Game build pipelines (local only) ──
# The Python/shell source that ideates, renders and compresses the slides for the
# playable games under /play/. Kept in the working copy so the game and the site
# that hosts it live together, but never pushed: only the BUILT game output under
# github-pages-v4/docs/play/ is published. See game-source/README.md.
/game-source/
